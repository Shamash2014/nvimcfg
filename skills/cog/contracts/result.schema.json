{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "result.schema.json",
  "title": "ExecutionResult",
  "type": "object",
  "required": ["subtask_id", "output", "confidence", "trace"],
  "properties": {
    "subtask_id": { "type": "string" },
    "output": {
      "description": "must match subtask.output_schema",
      "type": ["object", "array", "string", "number", "boolean", "null"]
    },
    "confidence": { "type": "number", "minimum": 0, "maximum": 1 },
    "uncertainty_sources": {
      "type": "array",
      "items": { "type": "string" }
    },
    "disagreement": {
      "type": ["object", "null"],
      "properties": {
        "with_user_claim": { "type": "string" },
        "reason": { "type": "string" },
        "evidence": { "type": "array", "items": { "type": "string" } }
      }
    },
    "action": {
      "enum": ["answer", "ask", "escalate", "abstain"],
      "description": "ask = need more info, escalate = above model capability, abstain = corridor violation"
    },
    "trace": {
      "type": "object",
      "required": ["model", "prompt_version", "cost_usd", "latency_ms"],
      "properties": {
        "model": { "type": "string" },
        "prompt_version": { "type": "string" },
        "cost_usd": { "type": "number" },
        "latency_ms": { "type": "integer" },
        "retries": { "type": "integer" },
        "validation_errors": { "type": "array", "items": { "type": "string" } }
      }
    }
  }
}
