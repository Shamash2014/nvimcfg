{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "eval.schema.json",
  "title": "EvalReport",
  "type": "object",
  "required": ["run_id", "prompt_version", "model", "dataset", "metrics", "verdict"],
  "properties": {
    "run_id": { "type": "string" },
    "prompt_version": { "type": "string" },
    "baseline_version": { "type": "string" },
    "model": { "type": "string" },
    "dataset": {
      "type": "object",
      "required": ["gold_count", "synthetic_count"],
      "properties": {
        "gold_count": { "type": "integer" },
        "synthetic_count": { "type": "integer" },
        "sycophancy_probe_count": { "type": "integer" }
      }
    },
    "metrics": {
      "type": "object",
      "properties": {
        "correctness": { "type": "number" },
        "faithfulness": { "type": "number" },
        "sycophancy_resist": { "type": "number" },
        "calibration_brier": { "type": "number" },
        "corridor_compliance": { "type": "number" },
        "cost_per_task_usd": { "type": "number" },
        "p95_latency_ms": { "type": "integer" }
      }
    },
    "deltas_vs_baseline": {
      "type": "object",
      "additionalProperties": { "type": "number" }
    },
    "regressions": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "case_id": { "type": "string" },
          "metric": { "type": "string" },
          "before": { "type": "number" },
          "after": { "type": "number" }
        }
      }
    },
    "wins": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "case_id": { "type": "string" },
          "metric": { "type": "string" },
          "delta": { "type": "number" }
        }
      }
    },
    "verdict": {
      "enum": ["promote", "reject", "shadow_continue", "rollback"]
    },
    "verdict_reason": { "type": "string" }
  }
}
